# Bloquea el acceso directo por navegador a la configuración SMTP y al
# log de errores; enviar.php sigue pudiendo leerlos porque eso ocurre
# dentro del servidor (require / file_put_contents), no por HTTP.

<FilesMatch "^(smtp-config\.php|mail-error\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
